<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Assets/Icons/Settings_icon.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.BarBackground" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="Brush.FieldBackground" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Brush.SegmentFill" Color="#636366"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#636366"/>
    <SolidColorBrush x:Key="Brush.ControlFill" Color="#48484A"/>
    <SolidColorBrush x:Key="Brush.ControlFillHover" Color="#5C5C5E"/>
    <SolidColorBrush x:Key="Brush.ControlFillPressed" Color="#6C6C6E"/>
    <SolidColorBrush x:Key="Brush.Separator" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Brush.RowHover" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ToastBackground" Color="#F22C2C2E"/>
    <SolidColorBrush x:Key="Brush.IconMuted" Color="#C7C7CC"/>

    <LinearGradientBrush x:Key="Brush.PanelGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#2C2C2E" Offset="0"/>
        <GradientStop Color="#1C1C1E" Offset="1"/>
    </LinearGradientBrush>

    <DrawingImage x:Key="IconSettings">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="{StaticResource SettingsGearSoftGeometry}">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#8E8E93" Opacity="0.2"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#8E8E93"
                                Geometry="{StaticResource SettingsGearHardGeometry}"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconSettingsHover">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="{StaticResource SettingsGearSoftGeometry}">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#F5F5F7" Opacity="0.2"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F5F5F7"
                                Geometry="{StaticResource SettingsGearHardGeometry}"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

