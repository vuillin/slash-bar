<Window x:Class="SlashBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <DataTemplate x:Key="ShortcutSlotTemplate">
            <StackPanel Width="78"
                        Margin="5,0"
                        Cursor="Hand"
                        Background="Transparent"
                        RenderTransformOrigin="0.5,0.5"
                        MouseEnter="ShortcutSlot_MouseEnter"
                        MouseLeave="ShortcutSlot_MouseLeave"
                        MouseLeftButtonUp="ShortcutSlot_MouseLeftButtonUp">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="{Binding OffsetY}"/>
                        <TranslateTransform Y="0"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsHitTestVisible" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Prefix}" Value="{x:Null}">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="60" Height="60"
                        CornerRadius="16"
                        Background="{Binding TileBackground}"
                        BorderBrush="{Binding TileBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Icon}"
                               Width="36" Height="36"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"/>
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="23"
                                   Foreground="#1C1C1E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Label}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="#FFFFFF"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="13"
                           Height="28"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="ChromeRoot"
          Margin="0,4,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ItemsControl x:Name="LeftShortcutSlots"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"
                      Opacity="0"
                      Focusable="False"
                      ItemTemplate="{StaticResource ShortcutSlotTemplate}"
                      RenderTransformOrigin="0.5,1">
            <ItemsControl.RenderTransform>
                <TranslateTransform x:Name="LeftShortcutSlide" Y="8"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Grid x:Name="RootBorder"
              Grid.Column="1"
              VerticalAlignment="Center"
              Opacity="0"
              RenderTransformOrigin="0.5,1"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BarSlideTransform" Y="16"/>
            </Grid.RenderTransform>

            <Border CornerRadius="18"
                    Background="{DynamicResource Brush.BarBackground}"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="8"
                                      Direction="90"
                                      Opacity="0.22"
                                      Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border Background="{DynamicResource Brush.BarBackground}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="4,0">

            <Grid Height="44" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="⌕"
                           FontSize="16"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <Grid Grid.Column="1">
                    <TextBlock x:Name="GhostText"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <TextBox x:Name="SearchBox"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             FontSize="15"
                             FontWeight="Medium"
                             CaretBrush="{DynamicResource Brush.TextPrimary}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Center"
                             SelectionBrush="#33007AFF"/>

                    <TextBlock Text="Search..."
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Border Background="{DynamicResource Brush.ControlFill}"
                            CornerRadius="8"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="esc"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Grid Width="18" Height="18"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonUp="SettingsButton_Click">
                        <Image x:Name="SettingsIconIdle"
                               Source="{DynamicResource IconSettings}"
                               Width="18" Height="18"
                               SnapsToDevicePixels="True"
                               IsHitTestVisible="False"/>
                        <Image x:Name="SettingsIconHover"
                               Source="{DynamicResource IconSettingsHover}"
                               Width="18" Height="18"
                               Opacity="0"
                               SnapsToDevicePixels="True"
                               IsHitTestVisible="False"/>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SettingsIconIdle"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="SettingsIconHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SettingsIconIdle"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="SettingsIconHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </StackPanel>

                <Popup x:Name="SuggestionsPopup"
                       PlacementTarget="{Binding ElementName=RootBorder}"
                       Placement="Top"
                       VerticalOffset="-10"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       Focusable="False"
                       PopupAnimation="None">
                    <Grid x:Name="SuggestionsCard"
                          Opacity="0"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          RenderTransformOrigin="0.5,1">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SuggestionsSlide" Y="10"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="16"
                                Background="{DynamicResource Brush.BarBackground}"
                                IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28"
                                                  ShadowDepth="6"
                                                  Direction="90"
                                                  Opacity="0.18"
                                                  Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource Brush.BarBackground}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="16">
                        <Border x:Name="SuggestionsHost"
                                Height="0"
                                ClipToBounds="True">
                            <StackPanel x:Name="SuggestionsPanel">
                                <ItemsControl x:Name="ModuleSuggestionsList"
                                              Margin="10,10,10,10"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,2"
                                                    Cursor="Hand"
                                                    Tag="{Binding Index}"
                                                    MouseLeftButtonUp="SuggestionItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.ControlFill}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Prefix}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#007AFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               Text="  ·  "/>
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               Text="{Binding Name}"/>
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               Text="  ·  "/>
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Description}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl x:Name="ArgSuggestionsList"
                                              Margin="10,10,10,10"
                                              Visibility="Collapsed"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,2"
                                                    Cursor="Hand"
                                                    Tag="{Binding Index}"
                                                    MouseLeftButtonUp="SuggestionItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.ControlFill}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Value}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#007AFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               Text="  ·  "/>
                                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Description}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            </Border>
        </Grid>

        <ItemsControl x:Name="RightShortcutSlots"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"
                      Opacity="0"
                      Focusable="False"
                      ItemTemplate="{StaticResource ShortcutSlotTemplate}"
                      RenderTransformOrigin="0.5,1">
            <ItemsControl.RenderTransform>
                <TranslateTransform x:Name="RightShortcutSlide" Y="8"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
