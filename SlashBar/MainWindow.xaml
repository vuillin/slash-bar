<Window x:Class="SlashBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0"
        Deactivated="Window_Deactivated">

    <!-- Capsule flottante style Apple (clair, comme les panneaux) -->
    <Border x:Name="RootBorder"
            Background="#F2F2F7"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="18"
            Padding="4,0"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="20"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              ShadowDepth="8"
                              Direction="90"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>

        <Grid Height="48" Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="⌕"
                       FontSize="16"
                       Foreground="#8E8E93"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Grid Grid.Column="1">
                <TextBlock x:Name="GhostText"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#C7C7CC"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <TextBox x:Name="SearchBox"
                         FontFamily="Segoe UI Variable Text, Segoe UI"
                         FontSize="15"
                         FontWeight="Medium"
                         CaretBrush="#1C1C1E"
                         Foreground="#1C1C1E"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         SelectionBrush="#33007AFF"/>

                <TextBlock Text="Rechercher..."
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#8E8E93"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Column="2"
                    Background="#E5E5EA"
                    CornerRadius="8"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0">
                <TextBlock Text="esc"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#8E8E93"
                           VerticalAlignment="Center"/>
            </Border>

            <Popup x:Name="SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=RootBorder}"
                   Placement="Top"
                   VerticalOffset="-10"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   Focusable="False"
                   PopupAnimation="None">
                <Border x:Name="SuggestionsCard"
                        Background="#F2F2F7"
                        BorderBrush="#1A000000"
                        BorderThickness="1"
                        CornerRadius="16"
                        Opacity="0"
                        SnapsToDevicePixels="True"
                        RenderTransformOrigin="0.5,1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SuggestionsSlide" Y="10"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28"
                                          ShadowDepth="6"
                                          Direction="90"
                                          Opacity="0.18"
                                          Color="#000000"/>
                    </Border.Effect>
                    <Border x:Name="SuggestionsHost"
                            Height="0"
                            ClipToBounds="True">
                        <StackPanel x:Name="SuggestionsPanel">
                            <ItemsControl x:Name="ModuleSuggestionsList"
                                          Margin="10,10,10,10"
                                          Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Padding="10,8"
                                                Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#E5E5EA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Prefix}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#007AFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           Foreground="#C7C7CC"
                                                           Text="  ·  "/>
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#1C1C1E"
                                                           Text="{Binding Name}"/>
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           Foreground="#C7C7CC"
                                                           Text="  ·  "/>
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="#8E8E93"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Description}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="ArgSuggestionsList"
                                          Margin="10,10,10,10"
                                          Visibility="Collapsed"
                                          Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Padding="10,8"
                                                Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#E5E5EA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Value}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#007AFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           Foreground="#C7C7CC"
                                                           Text="  ·  "/>
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="#8E8E93"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Description}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
