<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.6.0</Version>
    <AssemblyName>SlashBar</AssemblyName>
    <ApplicationIcon>Assets\App\slashbar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\Weather\*.png" />
    <Resource Include="Assets\App\slashbar.ico" />
  </ItemGroup>

</Project>
