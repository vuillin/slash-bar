<Window x:Class="SlashBar.ColorPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar Color"
        Width="320"
        Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True">

    <Border Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="12"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000"/>
        </Border.Effect>

        <Border x:Name="RootBorder"
                CornerRadius="24"
                Background="#F2F2F7"
                BorderBrush="#1A000000"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="HeaderBar"
                        Grid.Row="0"
                        Background="#E8E8ED"
                        BorderBrush="#14000000"
                        BorderThickness="0,0,0,1"
                        CornerRadius="24,24,0,0"
                        Padding="14,12"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                        Text="&#xE790;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Foreground="#8E8E93"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        IsHitTestVisible="False"/>

                        <TextBlock Grid.Column="1"
                                   Text="Couleur"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   Foreground="#3C3C43"
                                   VerticalAlignment="Center"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"/>

                        <Button Grid.Column="2"
                                Click="CloseButton_Click"
                                Width="19"
                                Height="19"
                                Cursor="Hand"
                                ToolTip="Fermer"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg"
                                            Background="#FF5D5B"
                                            CornerRadius="9.5"
                                            Width="19"
                                            Height="19">
                                        <Viewbox Width="7" Height="7"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="10" Height="10">
                                                <Path Stroke="#9B1C16"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#E0443E"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#C93A35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>


                <Border Grid.Row="1"
                        Background="#F2F2F7"
                        CornerRadius="0,0,24,24">
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>