<shell:DockedSidePanelWindow x:Class="SlashBar.ColorPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Color"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True"
        Loaded="Window_Loaded">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-414"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="12"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    Background="#F2F2F7"
                    BorderBrush="#1A000000"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="HeaderBar"
                            Grid.Row="0"
                            Background="#E8E8ED"
                            BorderBrush="#14000000"
                            BorderThickness="0,0,0,1"
                            CornerRadius="24,24,0,0"
                            Padding="14,12"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE790;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#8E8E93"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       IsHitTestVisible="False"/>

                            <TextBlock Grid.Column="1"
                                       Text="Color"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="#3C3C43"
                                       VerticalAlignment="Center"
                                       Opacity="0.55"
                                       IsHitTestVisible="False"/>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button x:Name="ResetButton"
                                        Click="ResetButton_Click"
                                        Width="19"
                                        Height="19"
                                        Cursor="Hand"
                                        ToolTip="Reset position"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Template="{StaticResource SidePanelResetButtonTemplate}"/>

                                <Button Click="CloseButton_Click"
                                        Width="19"
                                        Height="19"
                                        Cursor="Hand"
                                        ToolTip="Close"
                                        VerticalAlignment="Center"
                                        Template="{StaticResource SidePanelCloseButtonTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#F2F2F7"
                            CornerRadius="0,0,24,24"
                            Padding="16,14,16,18">

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="108"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SatValPicker"
                                        Grid.Column="0"
                                        Height="168"
                                        CornerRadius="14"
                                        ClipToBounds="True"
                                        BorderBrush="#1A000000"
                                        BorderThickness="1"
                                        Cursor="Cross"
                                        MouseLeftButtonDown="SatValPicker_MouseLeftButtonDown"
                                        MouseMove="SatValPicker_MouseMove"
                                        MouseLeftButtonUp="SatValPicker_MouseLeftButtonUp">

                                    <Grid>
                                        <Border x:Name="SatValHueLayer" CornerRadius="14"/>
                                        <Border CornerRadius="14">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="White" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="14">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#FF000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Ellipse x:Name="SatValMarker"
                                                 Width="16"
                                                 Height="16"
                                                 Stroke="White"
                                                 StrokeThickness="2.5"
                                                 Fill="Transparent"
                                                 IsHitTestVisible="False"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Margin="0"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="PreviewSwatch"
                                        Grid.Column="2"
                                        Height="168"
                                        CornerRadius="14"
                                        Background="#808080"
                                        BorderBrush="#1A000000"
                                        BorderThickness="1"
                                        ClipToBounds="True">

                                    <Border VerticalAlignment="Bottom"
                                            Margin="10,0,10,12"
                                            Background="#99000000"
                                            CornerRadius="9"
                                            Padding="8,6">
                                        <TextBlock x:Name="PreviewHexText"
                                                   Text="#808080"
                                                   FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <Grid Height="22" Margin="0,0,0,16">
                                <Border x:Name="HueBar"
                                        Height="12"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        BorderBrush="#1A000000"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                                        MouseMove="HueBar_MouseMove"
                                        MouseLeftButtonUp="HueBar_MouseLeftButtonUp">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FFFF0000" Offset="0"/>
                                            <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                            <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                            <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                            <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                            <GradientStop Color="#FFFF0000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Ellipse x:Name="HueThumb"
                                         Width="20"
                                         Height="20"
                                         Fill="White"
                                         Stroke="#26000000"
                                         StrokeThickness="0.5"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6"
                                                          ShadowDepth="1"
                                                          Direction="270"
                                                          Opacity="0.22"
                                                          Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#FFFFFF"
                                        CornerRadius="16"
                                        BorderBrush="#0F000000"
                                        BorderThickness="1"
                                        Padding="14,14,14,12">
                                    <StackPanel>
                                        <TextBlock Text="Hex"
                                                   FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#8E8E93"
                                                   Margin="0,0,0,8"/>

                                        <DockPanel LastChildFill="True" Margin="0,0,0,14">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="{Binding Background, ElementName=PreviewSwatch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <TextBlock x:Name="HexCardValue"
                                                       Text="#808080"
                                                       FontFamily="SF Mono, Cascadia Mono, Consolas, Segoe UI"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1C1C1E"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <Button Content="Copy"
                                                Click="CopyHex_Click"
                                                Height="34"
                                                Cursor="Hand"
                                                FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Foreground="#007AFF"
                                                Background="#EFEFF4"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#E5E5EA"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#D1D1D6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#FFFFFF"
                                        CornerRadius="16"
                                        BorderBrush="#0F000000"
                                        BorderThickness="1"
                                        Padding="14,14,14,12">
                                    <StackPanel>
                                        <TextBlock Text="RGB"
                                                   FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#8E8E93"
                                                   Margin="0,0,0,8"/>

                                        <DockPanel LastChildFill="True" Margin="0,0,0,14">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="{Binding Background, ElementName=PreviewSwatch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <TextBlock x:Name="RgbCardValue"
                                                       Text="128, 128, 128"
                                                       FontFamily="SF Mono, Cascadia Mono, Consolas, Segoe UI"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1C1C1E"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </DockPanel>

                                        <Button Content="Copy"
                                                Click="CopyRgb_Click"
                                                Height="34"
                                                Cursor="Hand"
                                                FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Foreground="#007AFF"
                                                Background="#EFEFF4"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#E5E5EA"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#D1D1D6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="HistorySection"
                                        Margin="0,18,0,0"
                                        Visibility="Collapsed">

                                <TextBlock Text="HISTORY"
                                        FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#8E8E93"
                                        Margin="4,0,0,10"/>

                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="40"
                                                    Margin="3,0"
                                                    CornerRadius="10"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="#1A000000"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    Tag="{Binding Entry}"
                                                    MouseLeftButtonDown="HistorySwatch_Click"
                                                    ToolTip="{Binding Hex}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CopiedToast"
                            Grid.RowSpan="2"
                            Style="{StaticResource SidePanelCopiedToastStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CopiedToastSlide" Y="8"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#34C759"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Copied"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#3C3C43"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="DockButton"
                    Grid.Column="2"
                    Click="DockButton_Click"
                    Width="34"
                    Height="100"
                    Margin="-2,0,0,0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Collapse / Expand"
                    Template="{StaticResource SidePanelDockButtonTemplate}">
                <Path x:Name="Chevron"
                      Stroke="#8E8E93"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="10"
                      Height="14"
                      Stretch="Uniform"
                      Data="M 6,0 L 1,6 L 6,12"/>
            </Button>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
