<Window x:Class="SlashBar.ColorPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar Color"
        Width="400"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        Loaded="Window_Loaded">

    <Border Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="12"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000"/>
        </Border.Effect>

        <Border x:Name="RootBorder"
                CornerRadius="24"
                Background="#F2F2F7"
                BorderBrush="#1A000000"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="HeaderBar"
                        Grid.Row="0"
                        Background="#E8E8ED"
                        BorderBrush="#14000000"
                        BorderThickness="0,0,0,1"
                        CornerRadius="24,24,0,0"
                        Padding="14,12"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE790;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#8E8E93"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   IsHitTestVisible="False"/>

                        <TextBlock Grid.Column="1"
                                   Text="Couleur"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   Foreground="#3C3C43"
                                   VerticalAlignment="Center"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"/>

                        <Button Grid.Column="2"
                                Click="CloseButton_Click"
                                Width="19"
                                Height="19"
                                Cursor="Hand"
                                ToolTip="Fermer"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg"
                                            Background="#FF5D5B"
                                            CornerRadius="9.5"
                                            Width="19"
                                            Height="19">
                                        <Viewbox Width="7" Height="7"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="10" Height="10">
                                                <Path Stroke="#9B1C16"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#E0443E"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#C93A35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#F2F2F7"
                        CornerRadius="0,0,24,24"
                        Padding="16,14,16,18">

                    <StackPanel>
                        <!-- Picker + aperçu -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="SatValPicker"
                                    Grid.Column="0"
                                    Height="168"
                                    CornerRadius="14"
                                    ClipToBounds="True"
                                    BorderBrush="#1A000000"
                                    BorderThickness="1"
                                    Cursor="Cross"
                                    MouseLeftButtonDown="SatValPicker_MouseLeftButtonDown"
                                    MouseMove="SatValPicker_MouseMove"
                                    MouseLeftButtonUp="SatValPicker_MouseLeftButtonUp">

                                <Grid>
                                    <Border x:Name="SatValHueLayer" CornerRadius="14"/>
                                    <Border CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#FF000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Ellipse x:Name="SatValMarker"
                                             Width="16"
                                             Height="16"
                                             Stroke="White"
                                             StrokeThickness="2.5"
                                             Fill="Transparent"
                                             IsHitTestVisible="False"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Margin="0"/>
                                </Grid>
                            </Border>

                            <Border x:Name="PreviewSwatch"
                                    Grid.Column="2"
                                    Height="168"
                                    CornerRadius="14"
                                    Background="#808080"
                                    BorderBrush="#1A000000"
                                    BorderThickness="1"
                                    ClipToBounds="True">

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="8,0,8,10">
                                    <Border Background="#CC000000"
                                            CornerRadius="8"
                                            Padding="8,5"
                                            Margin="0,0,0,6">
                                        <TextBlock x:Name="PreviewHexText"
                                                   Text="#808080"
                                                   FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   TextAlignment="Center"/>
                                    </Border>
                                    <Border Background="#CC000000"
                                            CornerRadius="8"
                                            Padding="8,5">
                                        <TextBlock x:Name="PreviewRgbText"
                                                   Text="rgb(128, 128, 128)"
                                                   FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                   FontSize="10"
                                                   Foreground="White"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Teinte -->
                        <Border x:Name="HueBar"
                                Height="14"
                                CornerRadius="7"
                                Margin="0,0,0,14"
                                BorderBrush="#1A000000"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                                MouseMove="HueBar_MouseMove"
                                MouseLeftButtonUp="HueBar_MouseLeftButtonUp">

                            <Grid>
                                <Border CornerRadius="7">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FFFF0000" Offset="0"/>
                                            <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                            <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                            <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                            <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                            <GradientStop Color="#FFFF0000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Ellipse x:Name="HueThumb"
                                         Width="18"
                                         Height="18"
                                         Stroke="White"
                                         StrokeThickness="2.5"
                                         Fill="Transparent"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="-9,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Cartes HEX / RGB -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="14"
                                    BorderBrush="#14000000"
                                    BorderThickness="1"
                                    Padding="12,12,12,10">
                                <StackPanel>
                                    <TextBlock Text="HEX"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#8E8E93"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="HexCardValue"
                                               Text="#808080"
                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#1C1C1E"
                                               Margin="0,0,0,12"/>
                                    <Button Content="COPY HEX"
                                            Click="CopyHex_Click"
                                            Height="36"
                                            Cursor="Hand"
                                            FontFamily="Segoe UI Variable Text, Segoe UI"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Background="#1C1C1E"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#3A3A3C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    CornerRadius="14"
                                    BorderBrush="#14000000"
                                    BorderThickness="1"
                                    Padding="12,12,12,10">
                                <StackPanel>
                                    <TextBlock Text="RGB"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#8E8E93"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="RgbCardValue"
                                               Text="rgb(128, 128, 128)"
                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1C1C1E"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <Button Content="COPY RGB"
                                            Click="CopyRgb_Click"
                                            Height="36"
                                            Cursor="Hand"
                                            FontFamily="Segoe UI Variable Text, Segoe UI"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Background="#007AFF"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#0066D6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
