<shell:DockedSidePanelWindow x:Class="SlashBar.ColorPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Color"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True"
        Loaded="Window_Loaded">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-404"/>
        </Border.RenderTransform>

        <Grid Margin="{StaticResource SidePanelShadowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    BorderBrush="#1A000000"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.14"
                                      Color="#000000"
                                      RenderingBias="Quality"/>
                </Border.Effect>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#E8E8ED" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <shell:SidePanelHeader x:Name="PanelHeader"
                                           Grid.Row="0"
                                           MinimizeClick="MinimizeButton_Click"
                                           CloseClick="CloseButton_Click"
                                           HeaderDrag="HeaderBar_MouseLeftButtonDown">
                        <shell:SidePanelHeader.LeadingContent>
                            <ToggleButton IsChecked="True"
                                          Width="28"
                                          Height="28"
                                          Cursor="Hand"
                                          ToolTip="Eyedropper"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="4,0,0,0"
                                          Background="Transparent"
                                          Checked="EyedropperToggle_Changed"
                                          Unchecked="EyedropperToggle_Changed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Width="28"
                                                Height="28">
                                            <Image Source="{StaticResource IconEyedropper}"
                                                   Width="15"
                                                   Height="15"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#14000000"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#E8E8ED"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="#DDDDE2"/>
                                            </MultiTrigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#DDDDE2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </shell:SidePanelHeader.LeadingContent>
                    </shell:SidePanelHeader>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            CornerRadius="0,0,24,24"
                            Padding="20,8,20,18">

                        <StackPanel>
                            <Grid Margin="0,0,0,8"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="136"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top">

                                    <Grid Width="168"
                                          Height="180"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True">

                                        <Border Width="168"
                                                Height="168"
                                                VerticalAlignment="Top"
                                                CornerRadius="14"
                                                Background="White">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24"
                                                                  ShadowDepth="6"
                                                                  Direction="270"
                                                                  Opacity="0.32"
                                                                  Color="#000000"
                                                                  RenderingBias="Quality"/>
                                            </Border.Effect>
                                        </Border>

                                        <Border x:Name="SatValPicker"
                                                Width="168"
                                                Height="168"
                                                VerticalAlignment="Top"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                SnapsToDevicePixels="True"
                                                Cursor="Cross"
                                                MouseLeftButtonDown="SatValPicker_MouseLeftButtonDown"
                                                MouseMove="SatValPicker_MouseMove"
                                                MouseLeftButtonUp="SatValPicker_MouseLeftButtonUp">
                                            <Border.Clip>
                                                <RectangleGeometry RadiusX="14"
                                                                   RadiusY="14"
                                                                   Rect="0,0,168,168"/>
                                            </Border.Clip>

                                            <Grid SnapsToDevicePixels="True">
                                                <Border x:Name="SatValHueLayer"/>
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Color="White" Offset="0"/>
                                                            <GradientStop Color="Transparent" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="Transparent" Offset="0"/>
                                                            <GradientStop Color="#FF000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Ellipse x:Name="SatValMarker"
                                                 Width="16"
                                                 Height="16"
                                                 Stroke="White"
                                                 StrokeThickness="2.5"
                                                 Fill="#808080"
                                                 IsHitTestVisible="False"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Margin="0"/>
                                    </Grid>

                                    <Grid Width="22"
                                          Height="184"
                                          Margin="10,0,0,0">

                                        <Border x:Name="HueBar"
                                                Width="16"
                                                Height="168"
                                                Margin="0,8,0,8"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                BorderBrush="#1A000000"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                                                MouseMove="HueBar_MouseMove"
                                                MouseLeftButtonUp="HueBar_MouseLeftButtonUp">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#FFFF0000" Offset="0"/>
                                                    <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                                    <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                                    <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                                    <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                                    <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                                    <GradientStop Color="#FFFF0000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Ellipse x:Name="HueThumb"
                                                 Width="16"
                                                 Height="16"
                                                 Stroke="White"
                                                 StrokeThickness="2.5"
                                                 Fill="#FF0000"
                                                 IsHitTestVisible="False"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Top"
                                                 Margin="0"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Grid.Column="2"
                                      Height="180"
                                      VerticalAlignment="Top">
                                    <Border Height="168"
                                            VerticalAlignment="Top"
                                            CornerRadius="14"
                                            Background="White">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24"
                                                              ShadowDepth="6"
                                                              Direction="270"
                                                              Opacity="0.32"
                                                              Color="#000000"
                                                              RenderingBias="Quality"/>
                                        </Border.Effect>
                                    </Border>

                                    <Border x:Name="PreviewSwatch"
                                            Height="168"
                                            VerticalAlignment="Top"
                                            CornerRadius="14"
                                            Background="#808080">

                                        <StackPanel VerticalAlignment="Bottom"
                                                    Margin="8,0,8,10">
                                        <Border Background="#99000000"
                                                CornerRadius="9"
                                                Padding="8,6"
                                                Margin="0,0,0,6"
                                                Cursor="Hand"
                                                ToolTip="Copy hex"
                                                MouseLeftButtonDown="CopyHex_Click">
                                            <DockPanel LastChildFill="True">
                                                <Image DockPanel.Dock="Right"
                                                       Source="{StaticResource IconCopy}"
                                                       Width="12"
                                                       Height="12"
                                                       Margin="8,0,0,0"
                                                       IsHitTestVisible="False"/>
                                                <TextBlock x:Name="PreviewHexText"
                                                           Text="#808080"
                                                           FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Background="#99000000"
                                                CornerRadius="9"
                                                Padding="8,6"
                                                Cursor="Hand"
                                                ToolTip="Copy RGB"
                                                MouseLeftButtonDown="CopyRgb_Click">
                                            <DockPanel LastChildFill="True">
                                                <Image DockPanel.Dock="Right"
                                                       Source="{StaticResource IconCopy}"
                                                       Width="12"
                                                       Height="12"
                                                       Margin="8,0,0,0"
                                                       IsHitTestVisible="False"/>
                                                <TextBlock x:Name="PreviewRgbText"
                                                           Text="128, 128, 128"
                                                           FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <StackPanel x:Name="HistorySection"
                                        Width="348"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">

                                <Border Height="1"
                                        Background="#12000000"
                                        Margin="0,0,0,14"/>

                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="40"
                                                    Margin="3,4"
                                                    CornerRadius="10"
                                                    Background="{Binding Brush}"
                                                    Cursor="Hand"
                                                    Tag="{Binding Entry}"
                                                    MouseLeftButtonDown="HistorySwatch_Click"
                                                    ToolTip="{Binding Hex}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10"
                                                                      ShadowDepth="2"
                                                                      Direction="270"
                                                                      Opacity="0.16"
                                                                      Color="#000000"
                                                                      RenderingBias="Quality"/>
                                                </Border.Effect>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Hex}"
                                                           FontFamily="SF Mono, Cascadia Mono, Consolas, Segoe UI"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding HexForeground}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CopiedToast"
                            Grid.RowSpan="2"
                            Style="{StaticResource SidePanelCopiedToastStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CopiedToastSlide" Y="8"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#34C759"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Copied"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#3C3C43"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
