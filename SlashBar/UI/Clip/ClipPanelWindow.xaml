<shell:DockedSidePanelWindow x:Class="SlashBar.ClipPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Clip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-354"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="12"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    Background="#F2F2F7"
                    BorderBrush="#1A000000"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="HeaderBar"
                            Grid.Row="0"
                            Background="#E8E8ED"
                            BorderBrush="#14000000"
                            BorderThickness="0,0,0,1"
                            CornerRadius="24,24,0,0"
                            Padding="14,12"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- clipboard icon -->
                            <Grid Grid.Column="0"
                                  Width="16"
                                  Height="18"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False">
                                <Border Width="11"
                                        Height="14"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="2"
                                        BorderBrush="#8E8E93"
                                        BorderThickness="1.6"
                                        Background="Transparent"/>
                                <Border Width="11"
                                        Height="14"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="2"
                                        BorderBrush="#8E8E93"
                                        BorderThickness="1.6"
                                        Background="#E8E8ED"/>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="Clipboard"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="#3C3C43"
                                       VerticalAlignment="Center"
                                       Opacity="0.55"
                                       IsHitTestVisible="False"/>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <!-- orange light: reset position -->
                                <Button x:Name="ResetButton"
                                        Click="ResetButton_Click"
                                        Width="19"
                                        Height="19"
                                        Cursor="Hand"
                                        ToolTip="Reset position"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Template="{StaticResource SidePanelResetButtonTemplate}"/>

                                <!-- red light: close -->
                                <Button Click="CloseButton_Click"
                                        Width="19"
                                        Height="19"
                                        Cursor="Hand"
                                        ToolTip="Close"
                                        VerticalAlignment="Center"
                                        Template="{StaticResource SidePanelCloseButtonTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#F2F2F7"
                            CornerRadius="0,0,24,24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="12,10,12,14">
                            <StackPanel>
                                <Button Click="ClearAllHistory_Click"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10"
                                        Padding="10,6"
                                        ToolTip="Clear all history"
                                        FontFamily="Segoe UI Variable Text, Segoe UI"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="#FF3B30"
                                        Content="Clear all">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#1AFF3B30"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#33FF3B30"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,10"
                                                    Cursor="Hand"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#14000000"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    MouseLeftButtonUp="HistoryItem_Click"
                                                    Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F8F8FA"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="40"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,10,0"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               Foreground="#3C3C43"/>

                                                    <!-- trash -->
                                                    <Button Grid.Column="1"
                                                            Click="DeleteHistoryItem_Click"
                                                            Tag="{Binding}"
                                                            Width="28"
                                                            Height="28"
                                                            Cursor="Hand"
                                                            ToolTip="Delete"
                                                            VerticalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg"
                                                                        Background="Transparent"
                                                                        CornerRadius="8"
                                                                        Width="28"
                                                                        Height="28">
                                                                    <Viewbox Width="13" Height="16"
                                                                             Stretch="Uniform"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center">
                                                                        <Canvas Width="24" Height="28">
                                                                            <Path x:Name="Icon"
                                                                                  Fill="#8E8E93"
                                                                                  Data="M9,2 L15,2 L16.5,5 L21,5 L21,7.5 L3,7.5 L3,5 L7.5,5 Z M5,10 L7.2,10 L7.2,22 L5,22 Z M10.9,10 L13.1,10 L13.1,22 L10.9,22 Z M16.8,10 L19,10 L19,22 L16.8,22 Z M4,26 L20,26 C21.1,26 22,25.1 22,24 L22,10 L2,10 L2,24 C2,25.1 2.9,26 4,26 Z"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#1AFF3B30"/>
                                                                        <Setter TargetName="Icon" Property="Fill" Value="#FF3B30"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#33FF3B30"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- "Copied" toast -->
                    <Border x:Name="CopiedToast"
                            Grid.RowSpan="2"
                            Style="{StaticResource SidePanelCopiedToastStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CopiedToastSlide" Y="8"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#34C759"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Copied"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#3C3C43"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- arrow tab -->
            <Button x:Name="DockButton"
                    Grid.Column="2"
                    Click="DockButton_Click"
                    Width="34"
                    Height="100"
                    Margin="-2,0,0,0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Collapse / Expand"
                    Template="{StaticResource SidePanelDockButtonTemplate}">
                <Path x:Name="Chevron"
                      Stroke="#8E8E93"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="10"
                      Height="14"
                      Stretch="Uniform"
                      Data="M 6,0 L 1,6 L 6,12"/>
            </Button>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
