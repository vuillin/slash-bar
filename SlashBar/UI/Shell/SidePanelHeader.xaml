<UserControl x:Class="SlashBar.UI.Shell.SidePanelHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Background="Transparent"
            CornerRadius="24,24,0,0"
            Padding="{Binding HeaderPadding, ElementName=Root}"
            Cursor="SizeAll"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <ContentPresenter Content="{Binding LeadingContent, ElementName=Root}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Margin="4,4,0,0"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{Binding TitleBrush, ElementName=Root}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding TitleVisibility, ElementName=Root}"/>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- Orange: minimize to shelf -->
                <Button Click="Minimize_Click"
                        Width="19"
                        Height="19"
                        Cursor="Hand"
                        ToolTip="Minimize"
                        Margin="0,0,8,0"
                        Template="{StaticResource SidePanelMinimizeButtonTemplate}"/>

                <!-- Red: close -->
                <Button Click="Close_Click"
                        Width="19"
                        Height="19"
                        Cursor="Hand"
                        ToolTip="Close"
                        VerticalAlignment="Center"
                        Template="{StaticResource SidePanelCloseButtonTemplate}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
