<shell:DockedSidePanelWindow x:Class="SlashBar.CalendarPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Calendar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0"/>
        </Border.RenderTransform>

        <Grid Margin="{StaticResource SidePanelShadowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.14"
                                      Color="#000000"
                                      RenderingBias="Quality"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="818"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <shell:SidePanelHeader x:Name="PanelHeader"
                                               Grid.Row="0"
                                               MinimizeClick="MinimizeButton_Click"
                                               CloseClick="CloseButton_Click"
                                               HeaderDrag="HeaderBar_MouseLeftButtonDown">
                            <shell:SidePanelHeader.LeadingContent>
                                <TextBlock Margin="4,4,0,0"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FF3B30"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </shell:SidePanelHeader.LeadingContent>
                        </shell:SidePanelHeader>

                        <Grid Grid.Row="1"
                            Margin="18,10,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="540"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- day timeline -->
                        <Grid Grid.Column="0"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,-10,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="DayNumber"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="23"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           IsHitTestVisible="False"/>

                                <ItemsControl x:Name="DayEventPills"
                                              Grid.Column="1"
                                              Margin="14,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#4DAF52DE"
                                                    CornerRadius="12"
                                                    Padding="2,2,8,2"
                                                    Margin="0,2,6,2"
                                                    MaxWidth="180"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Border Width="18"
                                                            Height="18"
                                                            CornerRadius="9"
                                                            Background="#CA73DF"
                                                            VerticalAlignment="Center">
                                                        <Viewbox Width="13"
                                                                 Height="13"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                            <Canvas Width="960" Height="960">
                                                                <Path Fill="#000006"
                                                                      Data="m233-120 65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z">
                                                                    <Path.RenderTransform>
                                                                        <TranslateTransform Y="960"/>
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>

                                                    <TextBlock Text="{Binding Title}"
                                                               Margin="6,0,2,0"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#A84FC0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <ScrollViewer x:Name="DayTimelineScroll"
                                          Grid.Row="1"
                                          Padding="0,0,30,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Template="{StaticResource SidePanelOverlayScrollViewerTemplate}">
                                <Grid Margin="0,0,2,8">
                                    <StackPanel x:Name="DayTimeline"/>

                                    <Grid x:Name="NowIndicator"
                                          Height="20"
                                          VerticalAlignment="Top"
                                          Visibility="Collapsed"
                                          IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#FF3B30"
                                                CornerRadius="8"
                                                Padding="5,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Panel.ZIndex="1">
                                            <TextBlock x:Name="NowIndicatorText"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Height="2"
                                                Background="#FF3B30"
                                                VerticalAlignment="Center"
                                                Margin="-6,0,4,0"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Column="1"
                                Width="1"
                                Margin="14,2,14,2"
                                Background="{DynamicResource Brush.Border}"
                                VerticalAlignment="Stretch"/>

                        <!-- month + event form -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right">
                            <StackPanel.RenderTransform>
                                <TranslateTransform X="0" Y="8"/>
                            </StackPanel.RenderTransform>
                            <StackPanel.Resources>
                                <Style x:Key="MonthDayHeader" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Style>

                                <Style x:Key="MonthNavSquare" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                    <Setter Property="Width" Value="26"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{DynamicResource Brush.ControlFill}"
                                                        CornerRadius="13">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ControlFillHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ControlFillPressed}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style x:Key="MonthNavPill" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="MinWidth" Value="58"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{DynamicResource Brush.ControlFill}"
                                                        CornerRadius="13"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ControlFillHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ControlFillPressed}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <StackPanel Width="200"
                                        HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8">
                                    <Button x:Name="PrevMonthButton"
                                            Style="{StaticResource MonthNavSquare}"
                                            Click="PrevMonthButton_Click">
                                        <TextBlock Text="‹"
                                                   FontSize="20"
                                                   Margin="0,-4,0,1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="MonthLabelButton"
                                            Style="{StaticResource MonthNavPill}"
                                            Margin="5,0"
                                            MinWidth="78"
                                            Click="MonthLabelButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="MonthLabel"
                                                       FontSize="12"
                                                       FontWeight="Medium"/>
                                            <TextBlock x:Name="YearLabel"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NextMonthButton"
                                            Style="{StaticResource MonthNavSquare}"
                                            Click="NextMonthButton_Click">
                                        <TextBlock Text="›"
                                                   FontSize="20"
                                                   Margin="0,-4,0,1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <UniformGrid Columns="7" Margin="0,0,0,2">
                                    <TextBlock Text="S" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="M" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="T" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="W" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="T" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="F" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="S" Style="{StaticResource MonthDayHeader}"/>
                                </UniformGrid>

                                <UniformGrid x:Name="MonthGrid"
                                             Columns="7"
                                             Height="138"/>

                                <Border Margin="0,24,0,0"
                                        Background="{DynamicResource Brush.ControlFill}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <Border Padding="10,9">
                                            <TextBox x:Name="EventTitleBox"
                                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                                     FontSize="13"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     CaretBrush="{DynamicResource Brush.TextPrimary}"
                                                     FocusVisualStyle="{x:Null}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Grid>
                                                                        <TextBlock x:Name="Placeholder"
                                                                                   Text="Event"
                                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                                   FontSize="13"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsHitTestVisible="False"
                                                                                   Visibility="Collapsed"/>
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                                      VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <MultiTrigger>
                                                                            <MultiTrigger.Conditions>
                                                                                <Condition Property="Text" Value=""/>
                                                                                <Condition Property="IsKeyboardFocused" Value="False"/>
                                                                            </MultiTrigger.Conditions>
                                                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                                        </MultiTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>

                                        <Border Height="1"
                                                Margin="10,0"
                                                Background="{DynamicResource Brush.Border}"/>

                                        <Button x:Name="RepeatRow"
                                                Cursor="Hand"
                                                Click="RepeatRow_Click"
                                                FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="Transparent"
                                                            Padding="10,10"
                                                            CornerRadius="0,0,10,10">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Viewbox Grid.Column="0"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center">
                                                    <Canvas Width="960" Height="960">
                                                        <Path Fill="{DynamicResource Brush.TextPrimary}"
                                                              Data="M286.15-100 140-246.15l146.15-146.16 42.16 43.39-72.77 72.77h430.61v-160h60v219.99H255.54l72.77 72.77L286.15-100Zm-72.3-423.85v-219.99h490.61l-72.77-72.77L673.85-860 820-713.85 673.85-567.69l-42.16-43.39 72.77-72.77H273.85v160h-60Z">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform Y="960"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>

                                                <TextBlock Grid.Column="1"
                                                           Text="Repeat"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock x:Name="RepeatValueText"
                                                           Grid.Column="2"
                                                           Text="Never"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="RepeatMenu"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             HasDropShadow="False"
                                                             FontFamily="Segoe UI Variable Text, Segoe UI"
                                                             FontSize="13">
                                                    <ContextMenu.Template>
                                                        <ControlTemplate TargetType="ContextMenu">
                                                            <Border Background="{DynamicResource Brush.PanelBackground}"
                                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="5"
                                                                    MinWidth="176"
                                                                    SnapsToDevicePixels="True">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="22"
                                                                                      ShadowDepth="4"
                                                                                      Direction="90"
                                                                                      Opacity="0.16"
                                                                                      Color="#000000"/>
                                                                </Border.Effect>
                                                                <StackPanel IsItemsHost="True"
                                                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ContextMenu.Template>
                                                    <ContextMenu.Resources>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <Border x:Name="Bd"
                                                                                Background="Transparent"
                                                                                CornerRadius="8"
                                                                                Padding="10,8"
                                                                                Margin="0,0.5"
                                                                                SnapsToDevicePixels="True">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="16"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock x:Name="CheckMark"
                                                                                           Text="✓"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#FF3B30"
                                                                                           HorizontalAlignment="Left"
                                                                                           VerticalAlignment="Center"
                                                                                           Visibility="Hidden"/>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{TemplateBinding Header}"
                                                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                                           FontSize="13"
                                                                                           FontWeight="Medium"
                                                                                           Foreground="{TemplateBinding Foreground}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="6,0,0,0"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ControlFillHover}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                                                               TargetType="Separator">
                                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Separator">
                                                                        <Border Height="1"
                                                                                Margin="8,4"
                                                                                Background="{DynamicResource Brush.Border}"
                                                                                SnapsToDevicePixels="True"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ContextMenu.Resources>
                                                    <MenuItem Header="Never" Click="RepeatMenuItem_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Every Day" Click="RepeatMenuItem_Click"/>
                                                    <MenuItem Header="Every Week" Click="RepeatMenuItem_Click"/>
                                                    <MenuItem Header="Every 2 Weeks" Click="RepeatMenuItem_Click"/>
                                                    <MenuItem Header="Every Month" Click="RepeatMenuItem_Click"/>
                                                    <MenuItem Header="Every Year" Click="RepeatMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="AddEventButton"
                                        Click="AddEventButton_Click"
                                        Margin="0,10,0,0"
                                        Height="28"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg"
                                                    Background="#FF3B30"
                                                    CornerRadius="8"
                                                    SnapsToDevicePixels="True">
                                                <TextBlock Text="Add Event"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#E8352B"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#D12F26"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <TextBlock x:Name="ViewEventsLabel"
                                           Text="View events"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="ViewEventsLabel_MouseLeftButtonUp"/>
                            </StackPanel>

                        </StackPanel>
                    </Grid>

                        <Border x:Name="PanelToast"
                                Grid.RowSpan="2"
                                Style="{StaticResource SidePanelCopiedToastStyle}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PanelToastSlide" Y="8"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ToastIcon"
                                           Text="✓"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#34C759"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="ToastText"
                                           Text="Added"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="EventsDrawer"
                            Grid.Column="1"
                            Width="0"
                            Background="{DynamicResource Brush.PanelBackground}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1,0,0,0"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Border.Resources>
                            <ControlTemplate x:Key="EventsFilterPillTemplate" TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="Transparent"
                                        CornerRadius="7"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Border.Resources>
                        <Grid Margin="14,14,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Events"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Margin="2,2,0,12"/>

                            <!-- All | Past | Recurring -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.ControlFill}"
                                    CornerRadius="9"
                                    Padding="2"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="FilterAllButton"
                                            Grid.Column="0"
                                            Content="All"
                                            Tag="All"
                                            Click="EventsFilter_Click"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            FontFamily="Segoe UI Variable Text, Segoe UI"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Padding="0,6"
                                            Template="{StaticResource EventsFilterPillTemplate}"/>

                                    <Button x:Name="FilterPastButton"
                                            Grid.Column="1"
                                            Content="Past"
                                            Tag="Past"
                                            Click="EventsFilter_Click"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            FontFamily="Segoe UI Variable Text, Segoe UI"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Padding="0,6"
                                            Template="{StaticResource EventsFilterPillTemplate}"/>

                                    <Button x:Name="FilterRecurringButton"
                                            Grid.Column="2"
                                            Content="Recurring"
                                            Tag="Recurring"
                                            Click="EventsFilter_Click"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            FontFamily="Segoe UI Variable Text, Segoe UI"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Padding="0,6"
                                            Template="{StaticResource EventsFilterPillTemplate}"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Template="{StaticResource SidePanelOverlayScrollViewerTemplate}">
                                <ItemsControl x:Name="EventsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.BarBackground}"
                                                    CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DetailLine}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Click="DeleteEvent_Click"
                                                            Tag="{Binding}"
                                                            Width="28"
                                                            Height="28"
                                                            Cursor="Hand"
                                                            ToolTip="Delete"
                                                            VerticalAlignment="Center"
                                                            FocusVisualStyle="{x:Null}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg"
                                                                        Background="Transparent"
                                                                        CornerRadius="8"
                                                                        Width="28"
                                                                        Height="28">
                                                                    <Viewbox Width="12"
                                                                             Height="15"
                                                                             Stretch="Uniform"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center">
                                                                        <Canvas Width="24" Height="28">
                                                                            <Path x:Name="Icon"
                                                                                  Fill="{DynamicResource Brush.TextSecondary}"
                                                                                  Data="M9,2 L15,2 L16.5,5 L21,5 L21,7.5 L3,7.5 L3,5 L7.5,5 Z M5,10 L7.2,10 L7.2,22 L5,22 Z M10.9,10 L13.1,10 L13.1,22 L10.9,22 Z M16.8,10 L19,10 L19,22 L16.8,22 Z M4,26 L20,26 C21.1,26 22,25.1 22,24 L22,10 L2,10 L2,24 C2,25.1 2.9,26 4,26 Z"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#1AFF3B30"/>
                                                                        <Setter TargetName="Icon" Property="Fill" Value="#FF3B30"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#33FF3B30"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
