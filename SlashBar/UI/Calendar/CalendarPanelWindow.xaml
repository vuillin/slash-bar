<shell:DockedSidePanelWindow x:Class="SlashBar.CalendarPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Calendar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-832"/>
        </Border.RenderTransform>

        <Grid Margin="{StaticResource SidePanelShadowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="818"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    Background="#FFFFFF"
                    BorderBrush="#1A000000"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.14"
                                      Color="#000000"
                                      RenderingBias="Quality"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <shell:SidePanelHeader x:Name="PanelHeader"
                                           Grid.Row="0"
                                           MinimizeClick="MinimizeButton_Click"
                                           CloseClick="CloseButton_Click"
                                           HeaderDrag="HeaderBar_MouseLeftButtonDown">
                        <shell:SidePanelHeader.LeadingContent>
                            <TextBlock Margin="4,4,0,0"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FF3B30"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </shell:SidePanelHeader.LeadingContent>
                    </shell:SidePanelHeader>

                    <Grid Grid.Row="1"
                        Margin="18,10,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="540"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- gauche : date + journée -->
                        <Grid Grid.Column="0"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="DayNumber"
                                       Grid.Row="0"
                                       Margin="0,-10,0,12"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="23"
                                       Foreground="#1C1C1E"
                                       IsHitTestVisible="False"/>

                            <ScrollViewer x:Name="DayTimelineScroll"
                                          Grid.Row="1"
                                          Padding="0,0,30,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Template="{StaticResource SidePanelOverlayScrollViewerTemplate}">
                                <Grid Margin="0,0,2,8">
                                    <StackPanel x:Name="DayTimeline"/>

                                    <!-- Current time (shown only for today) -->
                                    <Grid x:Name="NowIndicator"
                                          Height="20"
                                          VerticalAlignment="Top"
                                          Visibility="Collapsed"
                                          IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#FF3B30"
                                                CornerRadius="8"
                                                Padding="5,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Panel.ZIndex="1">
                                            <TextBlock x:Name="NowIndicatorText"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Height="2"
                                                Background="#FF3B30"
                                                VerticalAlignment="Center"
                                                Margin="-6,0,4,0"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Column="1"
                                Width="1"
                                Margin="14,2,14,2"
                                Background="#1A000000"
                                VerticalAlignment="Stretch"/>

                        <!-- droite : nav + calendrier -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right">
                            <StackPanel.RenderTransform>
                                <TranslateTransform X="0" Y="18"/>
                            </StackPanel.RenderTransform>
                            <StackPanel.Resources>
                                <Style x:Key="MonthDayHeader" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="#8E8E93"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Style>

                                <Style x:Key="MonthNavSquare" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="#2C2C2E"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                    <Setter Property="Width" Value="26"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="#E5E5EA"
                                                        CornerRadius="13">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#D8D8DD"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#C7C7CC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style x:Key="MonthNavPill" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="#2C2C2E"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Height" Value="24"/>
                                    <Setter Property="MinWidth" Value="58"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="#E5E5EA"
                                                        CornerRadius="13"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#D8D8DD"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#C7C7CC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <StackPanel Width="200"
                                        HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8">
                                    <Button x:Name="PrevMonthButton"
                                            Style="{StaticResource MonthNavSquare}"
                                            Click="PrevMonthButton_Click">
                                        <TextBlock Text="‹"
                                                   FontSize="20"
                                                   Margin="0,-4,0,1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="MonthLabelButton"
                                            Style="{StaticResource MonthNavPill}"
                                            Margin="5,0"
                                            MinWidth="78"
                                            Click="MonthLabelButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="MonthLabel"
                                                       FontSize="12"
                                                       FontWeight="Medium"/>
                                            <TextBlock x:Name="YearLabel"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="#8E8E93"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NextMonthButton"
                                            Style="{StaticResource MonthNavSquare}"
                                            Click="NextMonthButton_Click">
                                        <TextBlock Text="›"
                                                   FontSize="20"
                                                   Margin="0,-4,0,1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <UniformGrid Columns="7" Margin="0,0,0,2">
                                    <TextBlock Text="S" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="M" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="T" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="W" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="T" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="F" Style="{StaticResource MonthDayHeader}"/>
                                    <TextBlock Text="S" Style="{StaticResource MonthDayHeader}"/>
                                </UniformGrid>

                                <UniformGrid x:Name="MonthGrid"
                                             Columns="7"
                                             Height="138"/>

                                <Border Margin="0,14,0,0"
                                        Background="#F2F2F7"
                                        CornerRadius="10"
                                        Padding="10,5">
                                    <TextBox x:Name="EventTitleBox"
                                             FontFamily="Segoe UI Variable Text, Segoe UI"
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             Foreground="#1C1C1E"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CaretBrush="#1C1C1E"
                                             FocusVisualStyle="{x:Null}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <TextBlock x:Name="Placeholder"
                                                                           Text="Event"
                                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                           FontSize="13"
                                                                           FontWeight="Medium"
                                                                           Foreground="#8E8E93"
                                                                           VerticalAlignment="Center"
                                                                           IsHitTestVisible="False"
                                                                           Visibility="Collapsed"/>
                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                              VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="Text" Value=""/>
                                                                        <Condition Property="IsKeyboardFocused" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
