<shell:DockedSidePanelWindow x:Class="SlashBar.CalendarPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Calendar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-386"/>
        </Border.RenderTransform>

        <Grid Margin="{StaticResource SidePanelShadowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    Background="#FFFFFF"
                    BorderBrush="#1A000000"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.14"
                                      Color="#000000"
                                      RenderingBias="Quality"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <shell:SidePanelHeader Grid.Row="0"
                                           Title="Calendar"
                                           MinimizeClick="MinimizeButton_Click"
                                           CloseClick="CloseButton_Click"
                                           HeaderDrag="HeaderBar_MouseLeftButtonDown"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
