<shell:DockedSidePanelWindow x:Class="SlashBar.SettingsPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-470"/>
        </Border.RenderTransform>

        <Grid Margin="{StaticResource SidePanelShadowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="456"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.14"
                                      Color="#000000"
                                      RenderingBias="Quality"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <shell:SidePanelHeader Grid.Row="0"
                                           Title="Settings"
                                           MinimizeClick="MinimizeButton_Click"
                                           CloseClick="CloseButton_Click"
                                           HeaderDrag="HeaderBar_MouseLeftButtonDown"/>

                    <ScrollViewer Grid.Row="1"
                                  Padding="14,12,14,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Template="{StaticResource SidePanelOverlayScrollViewerTemplate}">
                        <ScrollViewer.Resources>
                            <Style x:Key="SettingsCategoryCard" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="14"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="6,4,6,14"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.06"
                                                          Color="#000000"
                                                          RenderingBias="Quality"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <ControlTemplate x:Key="SettingsSegmentButtonTemplate" TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </ScrollViewer.Resources>

                        <StackPanel>

                            <!-- Weather -->
                            <Border Style="{StaticResource SettingsCategoryCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <Image Source="{StaticResource IconWeatherAccent}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Weather"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid MinHeight="34"
                                          Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Default city"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource Brush.ControlFill}"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                Margin="12,0,0,0"
                                                MinWidth="140"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="City"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=WeatherCityBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="WeatherCityBox"
                                                         FontFamily="Segoe UI Variable Text, Segoe UI"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                                         CaretBrush="#0A84FF"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalAlignment="Center"
                                                         FocusVisualStyle="{x:Null}"
                                                         LostFocus="WeatherCityBox_LostFocus"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border Height="1"
                                            Background="{DynamicResource Brush.Separator}"
                                            Margin="0,0,0,6"/>

                                    <Grid MinHeight="34"
                                          Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Unit"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource Brush.ControlFill}"
                                                CornerRadius="8"
                                                Padding="2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="WeatherUnitCelsiusButton"
                                                        Content="°C"
                                                        Tag="celsius"
                                                        Click="WeatherUnit_Click"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        FontFamily="Segoe UI Variable Text, Segoe UI"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Padding="12,5"
                                                        Template="{StaticResource SettingsSegmentButtonTemplate}"/>
                                                <Button x:Name="WeatherUnitFahrenheitButton"
                                                        Content="°F"
                                                        Tag="fahrenheit"
                                                        Click="WeatherUnit_Click"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        FontFamily="Segoe UI Variable Text, Segoe UI"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Padding="12,5"
                                                        Template="{StaticResource SettingsSegmentButtonTemplate}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Height="1"
                                            Background="{DynamicResource Brush.Separator}"
                                            Margin="0,0,0,6"/>

                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Show sunrise / sunset"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="WeatherSunEventsToggle"
                                                      Grid.Column="1"
                                                      IsChecked="True"
                                                      Width="42"
                                                      Height="26"
                                                      Cursor="Hand"
                                                      VerticalAlignment="Center"
                                                      FocusVisualStyle="{x:Null}"
                                                      Checked="WeatherSunEventsToggle_Changed"
                                                      Unchecked="WeatherSunEventsToggle_Changed">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Track"
                                                            Width="42"
                                                            Height="26"
                                                            CornerRadius="13"
                                                            Background="#34C759">
                                                        <Ellipse x:Name="Thumb"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Fill="#FFFFFF"
                                                                 HorizontalAlignment="Right"
                                                                 Margin="2,0,2,0">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="4"
                                                                                  ShadowDepth="1"
                                                                                  Direction="270"
                                                                                  Opacity="0.2"
                                                                                  Color="#000000"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.ControlFill}"/>
                                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hotkeys -->
                            <Border Style="{StaticResource SettingsCategoryCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <Image Source="{DynamicResource IconHotkeysAccent}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Hotkeys"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid MinHeight="34"
                                          Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Open bar"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="Ctrl"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3">
                                                <TextBlock Text="Space"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1"
                                            Background="{DynamicResource Brush.Separator}"
                                            Margin="0,0,0,6"/>

                                    <Grid MinHeight="34"
                                          Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Quit"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="Ctrl"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="Shift"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3">
                                                <TextBlock Text="Q"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1"
                                            Background="{DynamicResource Brush.Separator}"
                                            Margin="0,0,0,6"/>

                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pin window"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="Ctrl"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="Shift"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Brush.ControlFill}"
                                                    CornerRadius="5"
                                                    Padding="7,3">
                                                <TextBlock Text="A"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Display -->
                            <Border Style="{StaticResource SettingsCategoryCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <Image Source="{StaticResource IconDisplayAccent}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Display"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Theme"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource Brush.ControlFill}"
                                                CornerRadius="8"
                                                Padding="2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="DisplayThemeLightButton"
                                                        Content="Light"
                                                        Tag="light"
                                                        Click="DisplayTheme_Click"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        FontFamily="Segoe UI Variable Text, Segoe UI"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Padding="12,5"
                                                        Template="{StaticResource SettingsSegmentButtonTemplate}"/>
                                                <Button x:Name="DisplayThemeDarkButton"
                                                        Content="Dark"
                                                        Tag="dark"
                                                        Click="DisplayTheme_Click"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        FontFamily="Segoe UI Variable Text, Segoe UI"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Padding="12,5"
                                                        Template="{StaticResource SettingsSegmentButtonTemplate}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>
