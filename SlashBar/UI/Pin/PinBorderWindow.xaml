<Window x:Class="SlashBar.PinBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar Pin Border"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">

    <Border BorderThickness="3"
            CornerRadius="2"
            Background="Transparent"
            BorderBrush="#995AC8FA"/>
</Window>
