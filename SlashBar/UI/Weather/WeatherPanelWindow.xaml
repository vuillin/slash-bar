<shell:DockedSidePanelWindow x:Class="SlashBar.WeatherPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SlashBar.UI.Shell"
        Title="SlashBar Weather"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True">

    <Border Background="Transparent"
            RenderTransformOrigin="0,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="-414"/>
        </Border.RenderTransform>

        <Grid Margin="{StaticResource SidePanelShadowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RootBorder"
                    Grid.Column="1"
                    CornerRadius="24"
                    BorderBrush="#1A000000"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.14"
                                      Color="#000000"
                                      RenderingBias="Quality"/>
                </Border.Effect>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#1B4F9C" Offset="0"/>
                        <GradientStop Color="#7EC8EE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="HeaderBar"
                            Grid.Row="0"
                            Background="Transparent"
                            CornerRadius="24,24,0,0"
                            Padding="14,12,14,8"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PlaceText"
                                       Grid.Column="0"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="240"
                                       Margin="0,0,8,0"
                                       IsHitTestVisible="False"/>

                            <Image x:Name="ConditionIcon"
                                   Grid.Column="1"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Direction="270"
                                                      Opacity="0.32"
                                                      Color="#000000"/>
                                </Image.Effect>
                            </Image>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button x:Name="ResetButton"
                                        Click="ResetButton_Click"
                                        Width="19"
                                        Height="19"
                                        Cursor="Hand"
                                        ToolTip="Reset position"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Template="{StaticResource SidePanelResetButtonTemplate}"/>

                                <Button Click="CloseButton_Click"
                                        Width="19"
                                        Height="19"
                                        Cursor="Hand"
                                        ToolTip="Close"
                                        VerticalAlignment="Center"
                                        Template="{StaticResource SidePanelCloseButtonTemplate}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            CornerRadius="0,0,24,24"
                            Padding="16,0,16,12">

                        <Grid>
                            <TextBlock x:Name="StatusText"
                                       Text="Loading…"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       Foreground="#B3FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <StackPanel x:Name="ContentCard"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TempText"
                                               Grid.Column="0"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="44"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ConditionText"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,1,0,0">
                                            <Viewbox Width="13"
                                                     Height="13"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,2,0">
                                                <Canvas Width="960" Height="960">
                                                    <Path Fill="#FFFFFF"
                                                          Data="M440-240v-368L296-464l-56-56 240-240 240 240-56 56-144-144v368h-80Z">
                                                        <Path.RenderTransform>
                                                            <TranslateTransform Y="960"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="HighText"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"/>
                                            <Viewbox Width="13"
                                                     Height="13"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,2,0">
                                                <Canvas Width="960" Height="960">
                                                    <Path Fill="#FFFFFF"
                                                          Data="M480-240 240-480l56-56 144 144v-368h80v368l144-144 56 56-240 240Z">
                                                        <Path.RenderTransform>
                                                            <TranslateTransform Y="960"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="LowText"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl x:Name="HourList"
                                              Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Label}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           Foreground="#CCFFFFFF"
                                                           HorizontalAlignment="Center"/>
                                                <Image Source="{Binding Icon}"
                                                       Width="22"
                                                       Height="22"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,2">
                                                    <Image.Effect>
                                                        <DropShadowEffect BlurRadius="8"
                                                                          ShadowDepth="2"
                                                                          Direction="270"
                                                                          Opacity="0.32"
                                                                          Color="#000000"/>
                                                    </Image.Effect>
                                                </Image>
                                                <TextBlock Text="{Binding Temperature}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shell:DockedSidePanelWindow>