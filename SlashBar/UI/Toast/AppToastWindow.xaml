<Window x:Class="SlashBar.AppToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Border x:Name="ToastRoot"
            Margin="0,0,0,0"
            Padding="16,12"
            CornerRadius="16"
            Background="#F2FFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            Opacity="0"
            RenderTransformOrigin="1,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastSlide" X="48"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ToastIcon"
                       Text="✓"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#34C759"
                       VerticalAlignment="Top"
                       Margin="0,1,10,0"/>
            <StackPanel MaxWidth="280">
                <TextBlock x:Name="ToastText"
                           Text=""
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="#3C3C43"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ToastDetail"
                           Text=""
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="#8E8E93"
                           Margin="0,2,0,0"
                           MaxWidth="280"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
