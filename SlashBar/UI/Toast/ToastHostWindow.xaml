<Window x:Class="SlashBar.ToastHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <StackPanel x:Name="ToastStack" HorizontalAlignment="Right">

        <!-- Sticky (Awake) — top slot -->
        <Border x:Name="StickyRoot"
                HorizontalAlignment="Right"
                Padding="16,12"
                Margin="0"
                CornerRadius="16"
                Background="#F2FFFFFF"
                BorderBrush="#1A000000"
                BorderThickness="1"
                Cursor="Hand"
                Opacity="0"
                Visibility="Collapsed"
                RenderTransformOrigin="1,0"
                MouseLeftButtonUp="StickyRoot_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StickySlide" X="48"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="6"
                                  Direction="270"
                                  Opacity="0.22"
                                  Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="●"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF9500"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="StickyText"
                           Text="Awake"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="#3C3C43"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StickyDetail"
                           Text=""
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="#8E8E93"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Ephemeral (success / error) — below sticky when both visible -->
        <Border x:Name="EphemeralRoot"
                HorizontalAlignment="Right"
                Padding="16,12"
                CornerRadius="16"
                Background="#F2FFFFFF"
                BorderBrush="#1A000000"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                RenderTransformOrigin="1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="EphemeralSlide" X="48"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="6"
                                  Direction="270"
                                  Opacity="0.22"
                                  Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="EphemeralIcon"
                           Text="✓"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#34C759"
                           VerticalAlignment="Top"
                           Margin="0,1,10,0"/>
                <StackPanel MaxWidth="280">
                    <TextBlock x:Name="EphemeralText"
                               Text=""
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="#3C3C43"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="EphemeralDetail"
                               Text=""
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               Foreground="#8E8E93"
                               Margin="0,2,0,0"
                               MaxWidth="280"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
