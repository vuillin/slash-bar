<Window x:Class="SlashBar.AwakeToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashBar Awake"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Border x:Name="ToastRoot"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="16,12"
            CornerRadius="16"
            Background="#F2FFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            Opacity="0"
            RenderTransformOrigin="1,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastSlide" X="48"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="●"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FF9500"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Awake"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="#3C3C43"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
